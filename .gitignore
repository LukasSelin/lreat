### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### Linux
# Backup files
*~

# Temporary files from deleted open files
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder
.Trash-*

# NFS temporary files
.nfs*
### Claude Code
# Worktrees live under .claude but are not part of the tree.
.claude/worktrees/

### lreat
# What every run of the simulation left behind, one folder per branch.
# Local by design: the numbers belong to the tree they were taken on.
/runs/

# A workspace is how owl/ is built from inside a worktree, where the relative
# replace in owl/go.mod does not reach gowl. It is local to the checkout.
go.work
go.work.sum
