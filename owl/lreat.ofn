Prefix(:=<https://github.com/LukasSelin/lreat/ontology#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<https://github.com/LukasSelin/lreat/ontology>
    Annotation(rdfs:comment "lreat's ontology, rendered from core/ontology by ./owl. Classes are what the world is made of; acts are the catalog the trees entail, one class per instantiated act, labelled with the key its habit slot is kept under. The numbers are the simulation's own: a tick is a day and a year is 360 of them, reach0 is how far into reach an act starts for a newborn, and prior-* is the moment an act or a class belongs to, one data property per habit coordinate. Nothing here is written by hand. Regenerate rather than edit."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Act "One act of the instantiated catalog: a schema bound to the leaf classes it operates on. The label is the key its habit slot is kept under."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Bench "Everything with the bench trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Buildable "Everything with the buildable trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Burnable "Everything with the burnable trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Company "Everything with the company trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Desk "Everything with the desk trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Direction "Which way a transfer runs."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Edible "Everything with the edible trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Forge "Everything with the forge trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Give "Handing over."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Hearth "Everything with the hearth trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Heavy "Everything with the heavy trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Living "Everything with the living trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Owned "Everything with the owned trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Passable "Everything with the passable trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Perishable "Everything with the perishable trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Process "A maturing a thing goes through on its own: monotone, on a clock, and readable in advance, which is what lets an act ask for it."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Public "Everything with the public trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Role "How a person stands to the actor, decided at the moment of acting rather than fixed in a tree."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Roofed "Everything with the roofed trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Seize "A gift the other way round. Everything that makes theft theft is in the traits and the valence, not in a separate verb."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Skill "A competence an act draws on and improves."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Stage "One named span of a process, measured in growing weather rather than in ticks passed: a wood raised in the autumn stands still until the thaw."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Store "Everything with the store trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Technology "A discovery an act is gated on, the settlement's or the actor's."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Trade "Everything with the trade trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Transform "A change that happens to a thing rather than one somebody does to it. Unlike a process it cannot be read in advance."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Verb "A kind of act - what changes when it is done."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Wears "Everything with the wears trait."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Workplace "A site trait that lends an act the tools it needs. A dwelling has all of them; the market lends a bench and a desk, the tavern a hearth."^^xsd:string)
    AnnotationAssertion(rdfs:comment :actor "Who does the act: a person, unless the schema names another creature."^^xsd:string)
    AnnotationAssertion(rdfs:comment :affords "What a site or a holder offers: the ground what lies in it and the brush a deer lives on, a person what is in their pack and their purse, the market what is on its shelves."^^xsd:string)
    AnnotationAssertion(rdfs:comment :arrestedBy "A site that stops the change."^^xsd:string)
    AnnotationAssertion(rdfs:comment :at-moment "What being at a site is like, one sub-property per habit coordinate."^^xsd:string)
    AnnotationAssertion(rdfs:comment :at "Where the act happens."^^xsd:string)
    AnnotationAssertion(rdfs:comment :atWorkplace "The act is done wherever this trait holds, rather than at a named site."^^xsd:string)
    AnnotationAssertion(rdfs:comment :becomes "What it turns into. A transform with none leaves nothing behind."^^xsd:string)
    AnnotationAssertion(rdfs:comment :changes "What the transform acts on."^^xsd:string)
    AnnotationAssertion(rdfs:comment :consumes "What the act spends. Without it the act cannot start."^^xsd:string)
    AnnotationAssertion(rdfs:comment :crop-ear "The phase a harvest asks for: a strip is not worth cutting until it is in ear, and a strip cut is bare ground again."^^xsd:string)
    AnnotationAssertion(rdfs:comment :direction "Which way the transfer runs."^^xsd:string)
    AnnotationAssertion(rdfs:comment :dwelling-to-open "an empty house fell in"^^xsd:string)
    AnnotationAssertion(rdfs:comment :granary-to-open "a granary fell in"^^xsd:string)
    AnnotationAssertion(rdfs:comment :handles "What the act operates on: the thing it is done to or with."^^xsd:string)
    AnnotationAssertion(rdfs:comment :heldIn "Whose keeping the thing is in while the transform runs. A transform with none is about a site, which is in nobody's."^^xsd:string)
    AnnotationAssertion(rdfs:comment :kept "Whether somebody living to keep the thing arrests the change, which is what makes ruin the fate of what is left behind rather than of everything."^^xsd:string)
    AnnotationAssertion(rdfs:comment :lack "How strongly being short of this registers. Inherited down the tree."^^xsd:string)
    AnnotationAssertion(rdfs:comment :mayUse "What improves the act without being needed for it: a stone in the walls of a house."^^xsd:string)
    AnnotationAssertion(rdfs:comment :pass-practice-to-pupil "Skilled, but in nothing this document names: what it draws on is the practice being handed over, and that is not known until the act is done."^^xsd:string)
    AnnotationAssertion(rdfs:comment :prior "The moment a thing belongs to, one sub-property per habit coordinate. On an act it is the composed prior; on a verb, a role or a trait it is what that contributes to one; on a class of thing it is the delta the class adds to the moment of lacking it."^^xsd:string)
    AnnotationAssertion(rdfs:comment :processOf "What the process happens to."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rate "For a transform, the share lost or the chance taken per tick; for a process, how much of a full stock the stand puts on per growing tick."^^xsd:string)
    AnnotationAssertion(rdfs:comment :reach0 "How far into reach the act starts for a newborn."^^xsd:string)
    AnnotationAssertion(rdfs:comment :requiresSkill "The competence the act draws on."^^xsd:string)
    AnnotationAssertion(rdfs:comment :requiresTech "The discovery the act is gated on."^^xsd:string)
    AnnotationAssertion(rdfs:comment :road-to-open "a road nobody walked grew over"^^xsd:string)
    AnnotationAssertion(rdfs:comment :season "The thing whose half of the year this act keeps, where the act itself handles none of it: clearing is warm-half work because a field is for grain."^^xsd:string)
    AnnotationAssertion(rdfs:comment :skilled "Whether how the act goes turns on how good the actor is at it."^^xsd:string)
    AnnotationAssertion(rdfs:comment :stageIndex "Where the stage falls in its process, from zero."^^xsd:string)
    AnnotationAssertion(rdfs:comment :stageOf "The process this stage belongs to."^^xsd:string)
    AnnotationAssertion(rdfs:comment :stageTicks "How much growing weather the stage takes, in days."^^xsd:string)
    AnnotationAssertion(rdfs:comment :take-fish-at-water "Skilled, but in nothing this document names: what it draws on is the practice being handed over, and that is not known until the act is done."^^xsd:string)
    AnnotationAssertion(rdfs:comment :take-grain-at-field "Skilled, but in nothing this document names: what it draws on is the practice being handed over, and that is not known until the act is done."^^xsd:string)
    AnnotationAssertion(rdfs:comment :take-stone-at-outcrop "Skilled, but in nothing this document names: what it draws on is the practice being handed over, and that is not known until the act is done."^^xsd:string)
    AnnotationAssertion(rdfs:comment :tavern-to-open "the tavern fell empty"^^xsd:string)
    AnnotationAssertion(rdfs:comment :ticks "How long the doing takes, in days."^^xsd:string)
    AnnotationAssertion(rdfs:comment :toward "Whom the act is done to or with."^^xsd:string)
    AnnotationAssertion(rdfs:comment :transfer-material-to-requester "Skilled, but in nothing this document names: what it draws on is the practice being handed over, and that is not known until the act is done."^^xsd:string)
    AnnotationAssertion(rdfs:comment :valence "How much an act upholds or violates each norm, one sub-property per norm. It is a property of the act, shared by everyone; what differs between agents is how much they care."^^xsd:string)
    AnnotationAssertion(rdfs:comment :verb "What kind of act this is."^^xsd:string)
    AnnotationAssertion(rdfs:comment :warmth "Which half of the year getting this belongs to: positive for the green half, negative for the cold one, zero for a thing had in any weather."^^xsd:string)
    AnnotationAssertion(rdfs:comment :yields "What the act or the process brings on."^^xsd:string)
    AnnotationAssertion(rdfs:label :Act "act"^^xsd:string)
